{
  "version": 5,
  "configurePresets": [
    {
      "name": "release",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "offline-evaluator",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/offline-evaluator",
      "cacheVariables": {"CLAB_BUILD_SUBSTRATES": "OFF"}
    },
    {
      "name": "sanitize",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release"},
    {"name": "offline-evaluator", "configurePreset": "offline-evaluator"},
    {"name": "sanitize", "configurePreset": "sanitize"}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "offline-evaluator", "configurePreset": "offline-evaluator", "output": {"outputOnFailure": true}},
    {"name": "sanitize", "configurePreset": "sanitize", "output": {"outputOnFailure": true}}
  ]
}
